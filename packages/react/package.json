{
  "name": "@mrigankad/nib-icons-react",
  "version": "1.3.0",
  "description": "Nib icons as tree-shakable React components. 2,196 line icons, one 1.5 stroke, MIT.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "files": [
    "src",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=17"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrigankad/nib-icons.git",
    "directory": "packages/react"
  },
  "homepage": "https://mrigankad.github.io/nib-icons/",
  "bugs": "https://github.com/mrigankad/nib-icons/issues",
  "keywords": [
    "react",
    "icons",
    "svg",
    "line icons",
    "react icons",
    "nib"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    },
    "./*": "./src/*.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}