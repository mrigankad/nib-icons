{
  "name": "@mrigankad/nib-icons",
  "version": "1.3.1",
  "description": "2,196 open source line icons on a 24px grid with one 1.5 stroke. Plain SVG, sprite and JSON.",
  "license": "MIT",
  "homepage": "https://mrigankad.github.io/nib-icons/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrigankad/nib-icons.git"
  },
  "bugs": "https://github.com/mrigankad/nib-icons/issues",
  "keywords": [
    "icons",
    "svg",
    "line icons",
    "icon set",
    "outline",
    "ui",
    "design system",
    "sprite"
  ],
  "files": [
    "icons/",
    "dist/sprite.svg",
    "dist/nib-figma.svg",
    "data/icons.json",
    "categories.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./icons/*": "./icons/*",
    "./sprite.svg": "./dist/sprite.svg",
    "./icons.json": "./data/icons.json",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}